      {
        "ClassName": "LocalScript",
        "Name": "Manager",
        "Properties": {
          "Archivable": true,
          "Disabled": false,
          "HistoryId": {
            "Type": "UniqueId",
            "Value": "00000000000000000000000000000000"
          },
          "LinkedSource": "",
          "RunContext": {
            "Name": "Legacy",
            "Enum": "Enum.RunContext",
            "Type": "EnumItem",
            "Value": 0
          },
          "Sandboxed": false,
          "ScriptGuid": "{8DA67D7C-6352-4BE6-A76A-6EBF6F861BD6}",
          "Source": "local player = game.Players.LocalPlayer\nlocal UITweening = require(game.ReplicatedStorage.Modules.UITweening)\n\n\nlocal leaderstats = player:FindFirstChild(\"leaderstats\")\nrepeat task.wait() leaderstats = player:FindFirstChild(\"leaderstats\") until leaderstats\nfunction FormatWithCommas(number)\n\tif type(number) ~= \"number\" then\n\t\twarn(\"FormatWithCommas expects a number, got\", type(number))\n\t\treturn tostring(number)\n\tend\n\n\tlocal formatted = tostring(math.floor(number))\n\tlocal k\n\n\twhile true do\n\t\tformatted, k = string.gsub(formatted, \"^(-?%d+)(%d%d%d)\", \"%1,%2\")\n\t\tif k == 0 then break end\n\tend\n\n\treturn formatted\nend\nlocal cash = leaderstats:WaitForChild(\"Cash\")\n\nscript.Parent.Main.Text = \"$\"..FormatWithCommas(tonumber(cash.Value)) --.. \" $\"\n\ncash.Changed:Connect(function()\n\tscript.Parent.Main.Text = \"$\"..FormatWithCommas(tonumber(cash.Value)) -- .. \" $\"\nend)",
          "SourceAssetId": -1,
          "UniqueId": {
            "Type": "UniqueId",
            "Value": "00000000000000000000000000000000"
          }
        }
